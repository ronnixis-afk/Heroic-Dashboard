# Supabase Configuration
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# RPG API Configuration
VITE_RPG_API_URL="http://localhost:3000"
RPG_API_URL=""
ADMIN_API_KEY=""

# Clerk Authentication
VITE_CLERK_PUBLISHABLE_KEY="pk_test_..."

# Administrative Access
# Comma-separated list of emails used as a fast client-side hint only.
# Authoritative admin checks go through RPG /api/admin/whoami.
VITE_SUPER_ADMIN_EMAILS="admin@example.com"

# Server-only MCP (never prefix with VITE_).
# MCP_API_KEY is the full-scope legacy key (principal name "legacy").
# MCP_API_KEYS maps a name to { sha256 (preferred) or key, scopes }.
# Scopes: read | monsters | patch_notes.
# Generate a key + hash: node scripts/generate-mcp-api-key.mjs reader read
MCP_API_KEY="legacy-full-scope-key-not-a-real-secret"
MCP_API_KEYS='{"reader":{"sha256":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","scopes":["read"]},"monster-bot":{"sha256":"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb","scopes":["read","monsters"]},"notes-bot":{"key":"plaintext-key-do-not-use-prefer-sha256","scopes":["patch_notes"]}}'
# Per-key write cap per minute. In-memory per serverless isolate. Default 30.
MCP_WRITE_LIMIT_PER_MIN=30
# Audit log (scripts/03_mcp_audit_log.sql). Insert failures are logged and do not fail the write.
SUPABASE_URL="https://example.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="service-role-fake-not-a-real-secret"
ADMIN_API_KEY=
RPG_API_URL="https://heroicairpg.com"
